# ─────────────────────────────────────────────────────────────────────────
#  MétodoAI — Environment variables
#  Copy to `.env` and fill in. Validated at boot by src/lib/env.ts (zod).
# ─────────────────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) ---------------------------------------------------
# Local dev: the bundled Docker Postgres (see docker-compose.yml) on DB_PORT.
# Production (Neon/Supabase): use the POOLED connection (pgBouncer) for
# DATABASE_URL and the DIRECT connection for DIRECT_URL (used by migrations).
DB_PORT=5433
DATABASE_URL="postgresql://metodoai:metodoai@localhost:5433/metodoai?schema=public"
DIRECT_URL="postgresql://metodoai:metodoai@localhost:5433/metodoai?schema=public"

# --- Auth --------------------------------------------------------------------
# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-32-char-minimum-random-secret"

# --- Integration credential encryption (REQUIRED) ----------------------------
# AES-256-GCM key, exactly 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENC_KEY="change-me-to-64-hex-chars"

# --- Public ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WhatsApp em desenvolvimento ----------------------------------------------
# Fora de produção, o WhatsApp só envia para estes números (ou JIDs de grupo ...@g.us),
# separados por vírgula, em qualquer formato. Vazio = nada sai. Ignorado em produção.
# O Evolution local costuma ser a VPS real: ponha só o seu celular. Ver docs/guia/07.
WHATSAPP_DEV_ALLOWED_NUMBERS=""
# --- WhatsApp oficial (Cloud API) ---------------------------------------------
# App Secret do app na Meta (confere a assinatura do webhook) e o token que você
# escolhe para a verificação da URL de retorno. Sem eles o webhook recusa tudo.
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
# Versão da Graph API. Vazio = v26.0.
META_GRAPH_VERSION=""
# Empresas (ids separados por vírgula) que veem a tela oficial e disparam campanha
# oficial no piloto. Vazio = ninguém. A trava de dev acima também vale para o oficial.
WHATSAPP_CLOUD_ORG_IDS=""
# Empresas (ids separados por vírgula) que veem "Adicionar a grupo do WhatsApp" no piloto.
# Vazio = ninguém. Em produção, comece só pela empresa MétodoAI.
WHATSAPP_GROUP_ADD_ORG_IDS=""

# --- Seed (first admin/owner of the demo organization) -----------------------
SEED_OWNER_EMAIL="owner@metodoai.local"
SEED_OWNER_PASSWORD="changeme123"
SEED_ORG_NAME="MétodoAI Demo"

# ─────────────────────────────────────────────────────────────────────────
#  The keys below are NOT required yet — they are introduced in later phases.
#  Listed here so you know what to provision. (Not validated by env.ts until
#  the phase that uses them lands.)
# ─────────────────────────────────────────────────────────────────────────

# --- P4: Background jobs / cache (Upstash) — optional until campaigns/extractors run
# QSTASH_TOKEN=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Integrations (WhatsApp, email, etc.) are connected per-tenant from the app's
# Connections page — there are no platform-managed default credentials.

# Autentica os endpoints /api/cron/* (enviado como `Authorization: Bearer <valor>`).
# Sem ele os 4 crons respondem 401 — ver README §8. Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Chave do servidor MCP de leitura (enviada como `Authorization: Bearer <valor>` ou em /api/mcp/<valor>).
# Sem ela /api/mcp responde 404 — ver docs/guia/05. Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=

# Object storage for chat media (Vercel Blob). Create a Blob store in Vercel → copy the token.
BLOB_READ_WRITE_TOKEN=

# Social sign-in (optional, one provider at a time). The button only appears
# once a provider's id + secret are set. Register the redirect URI exactly as:
#   ${NEXT_PUBLIC_SITE_URL}/api/auth/<provider>/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Envio de e-mail em massa pela caixa Microsoft da empresa (app "MetodoIA" no Entra).
MICROSOFT_MAIL_CLIENT_ID=""
MICROSOFT_MAIL_CLIENT_SECRET=""
# Envio de e-mail em massa pela conta Google da empresa (projeto Google separado do login).
# PILOT_ORG_IDS: ids de empresa separados por virgula; vazio = todas as empresas.
GOOGLE_MAIL_CLIENT_ID=""
GOOGLE_MAIL_CLIENT_SECRET=""
GOOGLE_MAIL_PILOT_ORG_IDS=""
# "common" (work/school + personal), "organizations", or a tenant id. Default: common
MICROSOFT_TENANT_ID=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
