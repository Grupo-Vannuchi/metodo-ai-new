// Prisma schema for MétodoAI — multi-tenant SaaS CRM.
//
// Tenancy model: every tenant is an `Organization`. A `User` is a global
// identity that joins one or more organizations via `Membership` (carrying the
// role). Every business record (CRM, prospecting, campaigns…) added in later
// phases MUST carry `organizationId` and be filtered by it in the DAL
// (src/lib/queries) — that is the security boundary. See PLANO.md §5.

generator client {
  provider = "prisma-client-js"
  // Production runs on Hostinger under Phusion Passenger + CloudLinux. Prisma's
  // native engines don't survive there: the `library` engine's Tokio runtime
  // dies on Passenger's fork ("PANIC: timer has gone away"), and the `binary`
  // engine can't spawn its process under the LVE process cap ("spawn ... EAGAIN").
  // `engineType = "client"` drops the Rust engine entirely — queries are compiled
  // in-process and run through the `pg` driver adapter, so there's no engine
  // process or native thread to break. See src/lib/prisma.ts.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection. On Neon/Supabase use the POOLED (pgBouncer) URL.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for `prisma migrate`/`db push` — migrations
  // can't run through a transaction pooler. Locally it's the same URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Auth
// ---------------------------------------------------------------------------

/// Role of a user *within* an organization.
enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Subscription tier. Gates features + seats + dispatch quota (src/config/plans.ts).
/// Install state of a module for an org. DORMANT = uninstalled but data kept, so
/// reinstalling restores everything (no destructive uninstall).
enum ModuleStatus {
  ACTIVE
  DORMANT
}

/// A tenant. All business data hangs off an organization via `organizationId`.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// The account owner (the user who created/owns this company). A single account
  /// (owner) can have several companies — the company switcher lists them. Module
  /// entitlements are billed at the account level (see AccountModule). Nullable
  /// only for the migration backfill; always set for orgs created afterwards.
  ownerId   String?
  /// Null until the owner finishes the "monte seu Método" onboarding (picks the
  /// first modules). Existing orgs are backfilled as already onboarded.
  onboardedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  modules              OrganizationModule[]
  notifications        Notification[]
  teamChats            TeamChat[]
  teamChatParticipants TeamChatParticipant[]
  teamChatMessages     TeamChatMessage[]
  teamChatFolders      TeamChatFolder[]
  feedPosts            FeedPost[]
  feedPostAttachments  FeedPostAttachment[]
  feedMentions         FeedMention[]
  feedReactions        FeedReaction[]
  feedComments         FeedComment[]
  feedPollOptions      FeedPollOption[]
  feedPollVotes        FeedPollVote[]
  pinnedItems          PinnedItem[]

  @@index([ownerId])
  @@map("organizations")
}

/// A module PURCHASED at the account level (by the owner). Billed once per module
/// regardless of how many of the account's companies install it. What a company
/// can actually install (OrganizationModule) is constrained to the account's
/// owned modules. Uninstalling from a company keeps the entitlement.
model AccountModule {
  id          String   @id @default(cuid())
  ownerUserId String
  moduleId    String
  createdAt   DateTime @default(now())

  owner User @relation("AccountModules", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, moduleId])
  @@index([ownerUserId])
  @@map("account_modules")
}

/// A module installed by an org from the MetodoLoja. `moduleId` matches an id in
/// src/config/modules.ts. Uninstalling flips status to DORMANT (data kept), so a
/// reinstall restores everything. Price/gating are resolved from the registry.
model OrganizationModule {
  id             String       @id @default(cuid())
  organizationId String
  moduleId       String
  status         ModuleStatus @default(ACTIVE)
  installedAt    DateTime     @default(now())
  uninstalledAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@index([organizationId])
  @@map("organization_modules")
}

/// A global user identity (login). Belongs to orgs through memberships.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Null for accounts that only sign in via an OAuth provider (e.g. Google).
  passwordHash String?
  /// Null until the user confirms their e-mail (login is gated on this). Set
  /// automatically for invited users and OAuth sign-ins (the provider proves it).
  emailVerified DateTime?
  /// A requested new e-mail awaiting confirmation (double opt-in). The change is
  /// only applied when the link sent to this address is confirmed (EMAIL_CHANGE
  /// token). Null when there's no pending change.
  pendingEmail String?
  /// Presence (team chat): heartbeat timestamp — "online" when recent.
  lastSeenAt   DateTime?
  /// Transient typing indicator: which chat the user is typing in, and when.
  typingChatId String?
  typingAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          Membership[]
  profile              UserProfile?
  notifications        Notification[]
  teamChatParticipants TeamChatParticipant[]
  teamChatMessages     TeamChatMessage[]
  feedPosts            FeedPost[]
  feedMentions         FeedMention[]
  feedReactions        FeedReaction[]
  feedComments         FeedComment[]
  feedPollVotes        FeedPollVote[]
  authTokens           AuthToken[]
  accounts             Account[]
  accountModules       AccountModule[] @relation("AccountModules")

  @@map("users")
}

/// A linked external identity (OAuth). A user can have several (Google today,
/// Microsoft/Apple later) — the pair (provider, providerAccountId) is unique.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // e.g. "google"
  providerAccountId String // the provider's stable user id (Google "sub")
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Purpose of a single-use auth token (e-mail confirmation or password reset).
enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

/// A single-use, expiring token for e-mail verification / password reset. Only
/// the SHA-256 hash of the opaque token is stored (the raw token travels in the
/// e-mail link), so a DB leak can't be used to verify/reset. Identity-level (not
/// tenant-scoped) — hangs off the User.
model AuthToken {
  id         String           @id @default(cuid())
  userId     String
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Document kind for a user profile. Brazilian individuals use CPF; companies
/// (or self-employed) use CNPJ.
enum DocumentType {
  CPF
  CNPJ
}

/// Rich profile for a user account, created from the data filled when the
/// account is created (signup or invite acceptance). Identity-level (tied to
/// the User, not an org) — an admin reads a member's profile through their
/// Membership (org-scoped). 1:1 with User.
model UserProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  phone         String?
  documentType  DocumentType?
  document      String? // digits only (normalized); validated as CPF/CNPJ
  position      String? // cargo/função na organização
  birthDate     DateTime?
  avatarUrl     String?
  addressZip    String?
  addressStreet String?
  addressNumber String?
  addressCity   String?
  addressState  String? // UF
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Join between a user and an organization, carrying the role.
model Membership {
  id               String   @id @default(cuid())
  organizationId   String
  userId           String
  role             Role     @default(MEMBER)
  /// Access template restricting which screens a MEMBER can reach. Null = full
  /// access. OWNER/ADMIN ignore this (they always have full access).
  accessTemplateId String?
  /// Team-chat organization (org-shared, like the WhatsApp inbox folders):
  /// which folder this member sits in, and whether they're pinned to the top.
  teamFolderId     String?
  teamPinned       Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTemplate AccessTemplate? @relation(fields: [accessTemplateId], references: [id], onDelete: SetNull)
  teamFolder     TeamChatFolder? @relation(fields: [teamFolderId], references: [id], onDelete: SetNull)

  // A user can belong to several companies (the account's companies + any org
  // they were invited to). Uniqueness is per (org, user) — not per user.
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([accessTemplateId])
  @@index([teamFolderId])
  @@map("memberships")
}

/// A named, reusable access profile (e.g. "Comercial", "Jurídico") that grants
/// MEMBERs access to a specific set of screens. Org-scoped.
model AccessTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Allowed screen keys (see src/config/screens.ts).
  screens        String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]

  @@index([organizationId])
  @@map("access_templates")
}

/// A pending invitation to join an organization with a given role.
model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// CRM (P3) — all rows carry `organizationId` (the tenant boundary). Reads go
// through the tenant-scoped client (src/lib/tenant-db.ts) / DAL; writes-by-id
// use `where: { id, organizationId }`.
// ---------------------------------------------------------------------------

/// A company in the CRM (a prospect or client account).
model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  cnpj           String?
  email          String?
  phone          String?
  website        String?
  /// Address broken down: { street, number, district, city, uf, zip, country }.
  address        Json     @default("{}")
  notes          String?
  /// Where it came from: "manual", "extractor:google", "import"…
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  folderId String?

  contacts      Contact[]
  opportunities Opportunity[]
  proposals     Proposal[]
  folder        CompanyFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([organizationId, name])
  @@index([organizationId, cnpj])
  @@index([organizationId, folderId])
  @@map("companies")
}

/// A person in the CRM, optionally tied to a company.
model Contact {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  folderId       String?
  name           String
  email          String?
  phone          String?
  role           String?
  tags           String[] @default([])
  source         String?
  /// LGPD: when true, the contact is excluded from campaigns (unsubscribed).
  optedOut       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  folder             ContactFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  opportunities      Opportunity[]
  proposals          Proposal[]
  campaignRecipients CampaignRecipient[]

  @@index([organizationId, companyId])
  @@index([organizationId, folderId])
  @@index([organizationId, name])
  @@map("contacts")
}

/// A user-defined folder to organize contacts (drag-and-drop on the grid view).
model ContactFolder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts Contact[]

  @@index([organizationId, order])
  @@map("contact_folders")
}

/// A user-defined folder to organize companies (drag-and-drop explorer).
model CompanyFolder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companies Company[]

  @@index([organizationId, order])
  @@map("company_folders")
}

/// A named, per-user preset of the CRM board's filters (funnel, owner, status,
/// period, view). Stored as the board's query string so applying one is just a
/// navigation. Scoped by a bare `organizationId` scalar, like the folder models.
model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// Which screen the preset belongs to (e.g. "crm"), so one table can serve
  /// more boards later.
  scope          String   @default("crm")
  name           String
  /// The board query string, e.g. "pipeline=abc&owner=me&status=WON".
  query          String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, userId, scope, order])
  @@map("saved_views")
}

/// A salesperson's monthly target (won value). Progress is computed against the
/// WON opportunities they own that closed in the month. Scoped by a bare
/// `organizationId` scalar, like the folder/view models.
model Goal {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// The month the target applies to, "YYYY-MM".
  month          String
  targetValue    Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, month])
  @@map("goals")
}

/// A "when X → do Y" rule for the CRM. Fires when an opportunity enters a stage
/// or is won/lost, then runs its ordered actions (create task, notify owner,
/// send a WhatsApp template). Scoped by a bare `organizationId` scalar.
model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  enabled        Boolean  @default(true)
  /// "stage_entered" | "opportunity_won" | "opportunity_lost"
  trigger        String
  /// The stage that fires a "stage_entered" rule (null for won/lost).
  triggerStageId String?
  /// Ordered actions: [{ type, ...config }].
  actions        Json     @default("[]")
  /// Editor + logic extras: { minValue?, layout?: { trigger, actions[] } }.
  config         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, trigger, enabled])
  @@map("automation_rules")
}

/// A sales pipeline (a board). Each org gets a default one.
model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stages        Stage[]
  opportunities Opportunity[]

  @@index([organizationId])
  @@map("pipelines")
}

/// A column of a pipeline (a funnel stage).
model Stage {
  id             String   @id @default(cuid())
  organizationId String
  pipelineId     String
  name           String
  order          Int      @default(0)
  probability    Int      @default(0) // 0–100
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([organizationId, pipelineId, order])
  @@map("stages")
}

enum OpportunityStatus {
  OPEN
  ON_HOLD
  WON
  LOST
  CANCELED
}

/// Whether a catalog item is a physical product or a service.
enum ProductKind {
  PRODUCT
  SERVICE
}

/// Catalog of products/services an opportunity can be tied to (org-scoped).
model ProductService {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  kind           ProductKind @default(SERVICE)
  price          Decimal?    @db.Decimal(14, 2)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  opportunities Opportunity[]
  proposalItems ProposalItem[]
  templateItems ProposalTemplateItem[]

  @@index([organizationId, active])
  @@map("product_services")
}

/// A deal / card on the Kanban board.
model Opportunity {
  id                String            @id @default(cuid())
  organizationId    String
  pipelineId        String
  stageId           String
  companyId         String?
  contactId         String?
  productServiceId  String?
  title             String
  /// Sequential per-org-per-year code, e.g. "0001/26".
  code              String?
  seqYear           Int?
  seqNumber         Int?
  value             Decimal           @default(0) @db.Decimal(14, 2)
  status            OpportunityStatus @default(OPEN)
  order             Int               @default(0) // position within the stage column
  ownerId           String? // membership/user responsible
  createdById       String? // membership/user who created it (for notifications)
  expectedCloseDate DateTime? // data prevista de fechamento
  notes             String?
  /// Reason for losing/canceling (required when status is LOST/CANCELED).
  outcomeReason     String?
  closedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  pipeline       Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage          Stage           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  attachments    OpportunityAttachment[]
  proposals      Proposal[]

  @@index([organizationId, pipelineId, stageId, order])
  @@index([organizationId, seqYear, seqNumber])
  @@map("opportunities")
}

/// A file attached to an opportunity. Bytes live in object storage (Supabase);
/// only metadata + the URL are kept here (never the bytes) so the DB stays light.
model OpportunityAttachment {
  id             String   @id @default(cuid())
  organizationId String
  opportunityId  String
  /// Original filename (for display + download).
  name           String
  mime           String
  /// Size in bytes.
  size           Int
  /// Public object-storage URL (Supabase / local media route).
  url            String
  uploadedById   String?
  createdAt      DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([organizationId, opportunityId])
  @@map("opportunity_attachments")
}

/// Lifecycle of a commercial proposal.
enum ProposalStatus {
  DRAFT // Rascunho
  SENT // Enviada ao cliente
  ACCEPTED // Aceita
  REJECTED // Recusada
  EXPIRED // Expirada (venceu a validade)
}

/// A commercial proposal / quote sent to a client. Optionally tied to a CRM
/// opportunity/company/contact; carries a client snapshot so the printed
/// document stays stable even if the linked records change later. Money is
/// stored (subtotal/discount/total) so lists and reports don't recompute.
model Proposal {
  id             String         @id @default(cuid())
  organizationId String
  /// Sequential per-org-per-year code, e.g. "PROP-0001/26".
  code           String?
  seqYear        Int?
  seqNumber      Int?
  title          String
  status         ProposalStatus @default(DRAFT)

  // Optional CRM links (SetNull so deleting the record keeps the proposal).
  opportunityId String?
  companyId     String?
  contactId     String?

  // Client snapshot (editable; prefilled from the linked records).
  clientCompany String?
  clientName    String?
  clientEmail   String?
  clientPhone   String?
  clientAddress String?

  /// Free intro / scope / terms text printed on the document.
  intro      String?  @db.Text
  /// Internal notes (never printed).
  notes      String?  @db.Text
  /// Rich document builder payload (cover/header/footer/sections). When present,
  /// the PDF/Word export renders this layout instead of the default template.
  /// Shape validated in src/lib/validations/proposal-template.ts.
  document   Json?
  validUntil DateTime?

  discount Decimal @default(0) @db.Decimal(14, 2)
  subtotal Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)

  ownerId     String?
  createdById String?
  sentAt      DateTime?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       ProposalItem[]
  attachments ProposalAttachment[]

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, seqYear, seqNumber])
  @@map("proposals")
}

/// A line item of a proposal (catalog product/service or free text).
model ProposalItem {
  id               String   @id @default(cuid())
  organizationId   String
  proposalId       String
  productServiceId String?
  /// Snapshot label (kept even if the catalog item is renamed/removed).
  name             String
  description      String?  @db.Text
  quantity         Decimal  @default(1) @db.Decimal(14, 2)
  unitPrice        Decimal  @default(0) @db.Decimal(14, 2)
  /// quantity × unitPrice, stored so totals don't recompute on read.
  total            Decimal  @default(0) @db.Decimal(14, 2)
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  proposal       Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, proposalId])
  @@map("proposal_items")
}

/// A file attached to a proposal. Bytes live in object storage (Supabase); only
/// metadata + the URL are kept here, mirroring OpportunityAttachment.
model ProposalAttachment {
  id             String   @id @default(cuid())
  organizationId String
  proposalId     String
  name           String
  mime           String
  size           Int
  url            String
  uploadedById   String?
  createdAt      DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([organizationId, proposalId])
  @@map("proposal_attachments")
}

/// A reusable, org-shared proposal template: a rich document blueprint plus
/// default commercial fields. When a proposal is generated from it, {{variables}}
/// in the document/text are substituted from the client/opportunity data.
model ProposalTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Rich document builder payload (cover/header/footer/signature/logos/sections).
  /// Shape validated in src/lib/validations/proposal-template.ts.
  document       Json
  /// Default validity in days (generated proposal's validUntil = today + N).
  validityDays   Int?
  discount       Decimal  @default(0) @db.Decimal(14, 2)
  ownerId        String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ProposalTemplateItem[]

  @@index([organizationId, name])
  @@map("proposal_templates")
}

/// A default line item of a proposal template (catalog product/service or free
/// text). Mirrors ProposalItem, minus the computed total (recomputed on use).
model ProposalTemplateItem {
  id               String   @id @default(cuid())
  organizationId   String
  templateId       String
  productServiceId String?
  name             String
  description      String?  @db.Text
  quantity         Decimal  @default(1) @db.Decimal(14, 2)
  unitPrice        Decimal  @default(0) @db.Decimal(14, 2)
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  template       ProposalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productService ProductService?  @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, templateId])
  @@map("proposal_template_items")
}

// ---------------------------------------------------------------------------
// Connections & Webhooks (P4)
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  EVOLUTION // WhatsApp via Evolution API
  META_CLOUD // WhatsApp Cloud API (Meta)
  GOOGLE // Maps / Custom Search
  RESEND // transactional / campaign email
  SMTP // generic SMTP
  N8N // workflow automation
}

enum ConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
}

/// A stored, per-tenant integration credential set. `credentialsEnc` is an
/// AES-256-GCM payload (see src/lib/integrations/crypto.ts) — never plaintext.
model IntegrationConnection {
  id             String              @id @default(cuid())
  organizationId String
  /// Owning user for personal connections (WhatsApp numbers are per-user).
  /// Null = org-level connection (Google, email, n8n…), managed by admins.
  ownerId        String?
  provider       IntegrationProvider
  label          String
  credentialsEnc String
  status         ConnectionStatus    @default(INACTIVE)
  lastTestAt     DateTime?
  meta           Json                @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, provider])
  @@index([organizationId, ownerId])
  @@map("integration_connections")
}

/// Per-connection WhatsApp AI auto-responder config. When enabled, inbound
/// customer messages on this connection are answered automatically by the AI
/// with the org's persona/prompt (unless a human is handling the chat).
model WhatsappAgent {
  id             String   @id @default(cuid())
  organizationId String
  /// One agent per WhatsApp connection (IntegrationConnection id).
  connectionId   String   @unique
  /// Off by default — a customer-facing bot must be turned on explicitly.
  enabled        Boolean  @default(false)
  /// Display name of the agent (e.g. "Bia").
  name           String?
  /// The persona / system prompt written by the client.
  prompt         String
  /// AI model id (defaults to a fast/cheap model for high-volume replies).
  model          String   @default("claude-haiku-4-5-20251001")
  /// Minutes the bot stays silent in a chat after a human replies there.
  handoffMinutes Int      @default(30)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("whatsapp_agents")
}

/// Inbound webhook endpoint configuration (a provider calls us here).
model WebhookEndpoint {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  secret         String
  events         String[]            @default([])
  createdAt      DateTime            @default(now())

  @@index([organizationId, provider])
  @@map("webhook_endpoints")
}

/// Idempotent log of received webhook events (dedupe by `dedupeKey`).
model WebhookEvent {
  id             String              @id @default(cuid())
  organizationId String?
  provider       IntegrationProvider
  eventType      String
  dedupeKey      String              @unique
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([organizationId, provider, eventType])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Dispatch / Campaigns (P6)
// ---------------------------------------------------------------------------

enum Channel {
  WHATSAPP_EVOLUTION
  WHATSAPP_CLOUD
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  DONE
  CANCELED
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// A reusable message template. `body` may contain {{nome}} / {{empresa}}.
model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  channel        Channel
  name           String
  subject        String? // for EMAIL
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, channel])
  @@map("message_templates")
}

/// A dispatch campaign over a channel.
model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  channel        Channel
  templateId     String?
  status         CampaignStatus @default(DRAFT)
  startAt        DateTime?
  /// Last time a dispatch batch ran for this campaign. Lets the per-minute cron
  /// avoid piling jobs onto an active (self-re-enqueuing, throttled) chain.
  lastDispatchAt DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([organizationId, status])
  @@map("campaigns")
}

/// One contact's slot in a campaign. Unique per (campaign, contact) so retries
/// never double-send.
model CampaignRecipient {
  id                String          @id @default(cuid())
  organizationId    String
  campaignId        String
  contactId         String
  status            RecipientStatus @default(PENDING)
  providerMessageId String?
  error             String?
  sentAt            DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Deleting a contact removes its slots from every campaign (no orphan rows).
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([organizationId, status])
  @@index([campaignId, status])
  @@index([providerMessageId])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// Audit log (P8)
// ---------------------------------------------------------------------------

/// Immutable trail of meaningful actions, per organization.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // e.g. "campaign.started"
  entity         String // e.g. "Campaign"
  entityId       String?
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Prospecting / lead extraction
// ---------------------------------------------------------------------------
// Discovery uses the official Google Places API (the tenant's own key); each
// result's website is then scraped for public contact info. Google Places data
// is treated as EPHEMERAL per Google's ToS (no long-term storage) — a scheduled
// job prunes finished extractions after a retention window. The durable record
// is what the user explicitly imports into the CRM.

enum ExtractionStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELED
}

/// A prospecting run: a Google Places text query enriched by website scraping.
model ExtractionJob {
  id             String           @id @default(cuid())
  organizationId String
  /// Search params: { segmento, localidade, nome, cnpj }.
  query          Json             @default("{}")
  status         ExtractionStatus @default(QUEUED)
  /// How many leads to collect (null = provider default, capped server-side).
  target         Int?
  /// Leads found so far.
  total          Int              @default(0)
  /// Google Places pagination cursor for the next batch.
  pageToken      String?
  error          String?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  leads ExtractedLead[]

  @@index([organizationId, status])
  @@index([status, createdAt])
  @@map("extraction_jobs")
}

/// One discovered business. Discovery fields (name/address/phone/website) come
/// from Google Places; enrichment fields (email/socials) come from the
/// business's own public website.
model ExtractedLead {
  id                String    @id @default(cuid())
  organizationId    String
  jobId             String
  placeId           String?
  name              String?
  segment           String?
  address           String?
  phone             String?
  whatsapp          String?
  email             String?
  website           String?
  instagram         String?
  facebook          String?
  linkedin          String?
  rating            Float?
  /// Set once the user imports this lead into the CRM (idempotent).
  importedCompanyId String?
  importedAt        DateTime?
  createdAt         DateTime  @default(now())

  job ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, jobId])
  @@map("extracted_leads")
}

// ---------------------------------------------------------------------------
// WhatsApp inbox (chat)
// ---------------------------------------------------------------------------
// Conversations and messages mirrored from the tenant's Evolution instance via
// the inbound webhook. The durable record of the chat lives here.

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  UNKNOWN
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Lifecycle of a message's media bytes in our own storage (Vercel Blob).
enum MediaStatus {
  PENDING
  READY
  FAILED
}

/// A WhatsApp chat with one remote party (a contact's number), tied to the
/// Evolution connection it flows through.
model Conversation {
  id                 String    @id @default(cuid())
  organizationId     String
  connectionId       String
  /// WhatsApp JID, e.g. "5511999999999@s.whatsapp.net" (individual) or
  /// "...@g.us" (group).
  remoteJid          String
  /// True when the JID is a WhatsApp group (`@g.us`). Groups have no CRM
  /// contact; `name` holds the group subject (resolved lazily, like the avatar).
  isGroup            Boolean   @default(false)
  name               String?
  /// User-set label that overrides the WhatsApp push name in the list. Never
  /// touched by inbound ingestion, so a rename sticks.
  customName         String?
  /// Optional link to a CRM contact (identified/created from the number).
  contactId          String?
  /// WhatsApp profile-picture URL + when we last refreshed it (cached ~weekly).
  avatarUrl          String?
  avatarCheckedAt    DateTime?
  /// Team member this conversation is assigned to (a User id), if any.
  assignedToId       String?
  /// Inbox organization: pin to top and optional folder.
  pinned             Boolean   @default(false)
  folderId           String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages Message[]
  folder   ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([connectionId, remoteJid])
  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

/// A folder to organize the WhatsApp inbox (org-scoped). Inbox-specific —
/// independent of the CRM's ContactFolder.
model ConversationFolder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations Conversation[]

  @@index([organizationId, order])
  @@map("conversation_folders")
}

/// A single message within a conversation (inbound or outbound).
model Message {
  id                String           @id @default(cuid())
  organizationId    String
  conversationId    String
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  body              String?
  mediaUrl          String?
  mediaMime         String?
  /// PENDING = bytes still being fetched/stored; READY = playable; FAILED = give up.
  mediaStatus       MediaStatus?
  /// Original filename (documents) and known metadata captured from the webhook.
  mediaName         String?
  mediaSize         Int?
  /// Audio/video length in seconds (lets the player render before bytes load).
  mediaDurationSec  Int?
  mediaWidth        Int?
  mediaHeight       Int?
  /// Provider message id (Baileys key id) — idempotency + status mapping.
  providerMessageId String?
  status            MessageStatus?
  fromMe            Boolean          @default(false)
  /// True when THIS outbound message was authored by the WhatsApp AI agent (not
  /// a human on the Inbox nor the owner replying from their phone). Lets the
  /// agent detect a human takeover (handoff) and not silence itself.
  agentReply        Boolean          @default(false)
  /// In group chats, the display name of the participant who sent this inbound
  /// message (null for individual chats and own messages).
  senderName        String?
  /// Emoji reactions on this message: [{ emoji, fromMe, senderName? }]. One per
  /// participant (WhatsApp semantics) — a new reaction replaces the previous.
  reactions         Json             @default("[]")
  /// Reply/quote: a snapshot of the message this one replies to (kept as a
  /// snapshot so it renders even if the original isn't stored). quotedMessageId
  /// is the quoted message's provider id (for scroll-to), not a FK.
  quotedMessageId   String?
  quotedBody        String?
  quotedSender      String?
  timestamp         DateTime
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@index([providerMessageId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Finance (Financeiro) — DRE, cash flow, entries (receitas/despesas)
// ---------------------------------------------------------------------------

/// Whether an entry is money in (receita) or money out (despesa).
enum FinanceType {
  INCOME
  EXPENSE
}

/// PENDING = a receber / a pagar; SETTLED = recebido / pago (realizado).
enum FinanceStatus {
  PENDING
  SETTLED
}

/// Payment method for an entry (optional).
enum FinanceMethod {
  PIX
  BOLETO
  CARD
  CASH
  TRANSFER
  OTHER
}

/// A DRE/report category, scoped to the org and to a type (receita/despesa).
model FinanceCategory {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  type           FinanceType
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  entries FinanceEntry[]

  @@unique([organizationId, type, name])
  @@index([organizationId, type])
  @@map("finance_categories")
}

/// A financial entry (lançamento): a single receita or despesa. The ledger that
/// feeds Receitas, Despesas, Fluxo de Caixa and DRE. CRM links are stored as ids
/// (no PII duplicated); names are resolved at read time.
model FinanceEntry {
  id                 String         @id @default(cuid())
  organizationId     String
  type               FinanceType
  description        String
  amount             Decimal        @db.Decimal(12, 2)
  status             FinanceStatus  @default(PENDING)
  /// Competência/vencimento (accrual basis — drives DRE).
  dueDate            DateTime
  /// When it was actually paid/received (cash basis — drives Fluxo de Caixa).
  settledAt          DateTime?
  method             FinanceMethod?
  notes              String?
  categoryId         String?
  /// Optional CRM links (ids only).
  contactId          String?
  companyId          String?
  opportunityId      String?
  /// Optional HR links (ids only) — set when a payroll run is paid, so a salary
  /// expense traces back to the employee and to the folha that generated it.
  employeeId         String?
  payrollRunId       String?
  /// Set when a purchase order is posted, so the expense traces back to the OC.
  purchaseOrderId    String?
  /// Installments: entries of the same sale share a group id (NNNN.../uuid),
  /// with their position (installmentNo) out of installmentTotal.
  installmentGroupId String?
  installmentNo      Int?
  installmentTotal   Int?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueDate])
  @@index([organizationId, type, status])
  @@index([organizationId, settledAt])
  @@index([organizationId, opportunityId])
  @@index([organizationId, contactId])
  @@index([organizationId, employeeId])
  @@index([organizationId, payrollRunId])
  @@index([organizationId, purchaseOrderId])
  @@map("finance_entries")
}

// ---------------------------------------------------------------------------
// Tasks / Activities — the follow-up layer that links CRM, inbox and finance.
// ---------------------------------------------------------------------------

enum TaskType {
  CALL
  MEETING
  EMAIL
  WHATSAPP
  FOLLOWUP
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// Workflow status. `doneAt` stays the completion marker (DONE ⟺ doneAt != null);
/// IN_PROGRESS is the Teams-style "em andamento" state.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// How a task repeats. On completion, a recurring task spawns its next
/// occurrence with the dates advanced by this interval.
enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// A task / next action (org-scoped). Optionally tied to a contact, company or
/// opportunity (ids only, like Conversation/FinanceEntry — names resolved on
/// read). `doneAt` marks completion.
model Task {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  description    String?
  type           TaskType       @default(OTHER)
  priority       TaskPriority   @default(MEDIUM)
  status         TaskStatus     @default(TODO)
  /// Completion percentage 0-100 (auto-derived from the checklist when it has
  /// items; otherwise follows the status / a manual value).
  progress       Int            @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  /// When to remind the assignee (surfaced by the notification digest).
  reminderAt     DateTime?
  recurrence     TaskRecurrence @default(NONE)
  doneAt         DateTime?
  assignedToId   String? // User responsible
  createdById    String?
  contactId      String?
  companyId      String?
  opportunityId  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  checklist   TaskChecklistItem[]
  attachments TaskAttachment[]

  @@index([organizationId, assignedToId, doneAt])
  @@index([organizationId, dueDate])
  @@index([organizationId, reminderAt])
  @@index([organizationId, opportunityId])
  @@index([organizationId, contactId])
  @@map("tasks")
}

/// A checklist item / subtask of a Task. Ordered; completion feeds the task's
/// progress. Tenant-scoped by `organizationId` (plain field, like the parent).
model TaskChecklistItem {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  text           String
  done           Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

/// A file attachment on a Task. Bytes live in object storage; only metadata +
/// URL are stored (mirrors OpportunityAttachment).
model TaskAttachment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  name           String
  mime           String
  size           Int
  url            String
  uploadedById   String?
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, taskId])
  @@map("task_attachments")
}

/// A persistent notification for the user. Used for assigned tasks, mentions,
/// and daily digests of overdue/stale items.
model Notification {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// Granular kind, drives the icon + localized label in the bell. One of the
  /// NotificationKind values (see src/lib/notifications/kinds.ts).
  type String

  /// i18n interpolation values for the localized message (e.g. { count } for a
  /// digest, or { actor, title } for an assignment). Rendered client-side.
  data Json?

  /// Where clicking the notification navigates (e.g. "/app/tasks/123").
  link String?

  /// Set when the user clears notifications or opens this one.
  readAt DateTime?

  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Internal Team Chat
// ---------------------------------------------------------------------------

enum TeamChatAttachmentType {
  TASK
  OPP
  CONTACT
  COMPANY
  LEAD
}

model TeamChat {
  id                 String    @id @default(cuid())
  organizationId     String
  /// Canonical key for a 1:1 chat ("<orgId>:<sortedUserIdA>:<sortedUserIdB>"),
  /// unique so a direct chat can be upserted without racing duplicates. Null for
  /// group channels.
  dmKey              String?   @unique
  /// Group channel name (null = a 1:1 direct message).
  name               String?
  isGroup            Boolean   @default(false)
  createdById        String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  participants TeamChatParticipant[]
  messages     TeamChatMessage[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, lastMessageAt])
}

model TeamChatParticipant {
  id             String   @id @default(cuid())
  organizationId String
  chatId         String
  userId         String
  unreadCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chat         TeamChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([organizationId, userId])
}

model TeamChatMessage {
  id             String @id @default(cuid())
  organizationId String
  chatId         String
  senderId       String
  body           String

  attachmentType  TeamChatAttachmentType?
  attachmentId    String?
  /// Snapshot of the attached entity's label + link, resolved at send time so
  /// the bubble renders without N+1 lookups and survives the entity changing.
  attachmentLabel String?
  attachmentHref  String?

  /// File attachment (image/document): bytes in object storage, metadata here.
  fileUrl  String?
  fileName String?
  fileMime String?
  fileSize Int?

  /// Reply/quote to another message in this chat.
  replyToId String?
  /// Emoji reactions: [{ emoji, userId }].
  reactions Json @default("[]")
  /// Mentioned user ids: ["userId", …] (for @mentions + notifications).
  mentions  Json @default("[]")
  editedAt  DateTime?
  deletedAt DateTime?
  /// Pinned to the top of the chat (any participant can pin/unpin).
  pinnedAt  DateTime?

  createdAt DateTime @default(now())

  chat         TeamChat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replyTo      TeamChatMessage?  @relation("TeamMsgReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      TeamChatMessage[] @relation("TeamMsgReply")

  @@index([chatId, createdAt])
  @@index([chatId, pinnedAt])
}

model TeamChatFolder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([organizationId, order])
  @@map("team_chat_folders")
}

// ---------------------------------------------------------------------------
// Team feed (ephemeral 24h posts by managers, with mentions + reactions)
// ---------------------------------------------------------------------------

/// Post category on the team wall — drives the badge colour/icon and filtering.
enum FeedCategory {
  GENERAL
  ANNOUNCEMENT
  NEWS
  EVENT
  PRAISE
}

model FeedPost {
  id             String       @id @default(cuid())
  organizationId String
  authorId       String
  body           String?
  category       FeedCategory @default(GENERAL)
  /// Pinned posts sort to the top of the wall and never expire.
  pinnedAt       DateTime?
  /// When the post disappears from the wall. Null = permanent (kept in history).
  /// Set (now + 24h) for ephemeral posts. Pinned posts are always permanent.
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments  FeedPostAttachment[]
  mentions     FeedMention[]
  reactions    FeedReaction[]
  comments     FeedComment[]
  pollOptions  FeedPollOption[]
  pollVotes    FeedPollVote[]

  @@index([organizationId, createdAt])
  @@index([organizationId, pinnedAt])
  @@map("feed_posts")
}

/// A comment/reply on a wall post (threaded discussion).
model FeedComment {
  id             String   @id @default(cuid())
  organizationId String
  postId         String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  post         FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([postId, createdAt])
  @@map("feed_comments")
}

/// One option of a poll attached to a wall post. A post is a poll when it has
/// two or more options.
model FeedPollOption {
  id             String @id @default(cuid())
  organizationId String
  postId         String
  text           String
  order          Int    @default(0)

  post         FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  votes        FeedPollVote[]

  @@index([postId])
  @@map("feed_poll_options")
}

/// A single-choice poll vote — one per user per post (unique).
model FeedPollVote {
  id             String   @id @default(cuid())
  organizationId String
  postId         String
  optionId       String
  userId         String
  createdAt      DateTime @default(now())

  post         FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  option       FeedPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([organizationId])
  @@index([optionId])
  @@map("feed_poll_votes")
}

model FeedPostAttachment {
  id             String                 @id @default(cuid())
  organizationId String
  postId         String
  type           TeamChatAttachmentType
  entityId       String
  /// Snapshot of the entity's label + link, resolved at post time.
  label          String
  href           String

  post         FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([postId])
  @@map("feed_post_attachments")
}

model FeedMention {
  id             String @id @default(cuid())
  organizationId String
  postId         String
  userId         String

  post         FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([organizationId])
  @@map("feed_mentions")
}

model FeedReaction {
  id             String   @id @default(cuid())
  organizationId String
  postId         String
  userId         String
  emoji          String
  createdAt      DateTime @default(now())

  post         FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([organizationId])
  @@index([postId])
  @@map("feed_reactions")
}

// ---------------------------------------------------------------------------
// Personal hub (Meus Itens) — pins/favourites
// ---------------------------------------------------------------------------

/// Entity kinds a user can pin. Values mirror resolveAttachment() so the same
/// resolver builds the label + link.
enum PinnedEntity {
  TASK
  OPP
  CONTACT
  COMPANY
}

/// A user's pinned/favourited item, shown on their personal hub. One per
/// (user, entity); org-scoped.
model PinnedItem {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  entityType     PinnedEntity
  entityId       String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([organizationId, userId])
  @@map("pinned_items")
}

// ---------------------------------------------------------------------------
// Human Resources (RH) — employees, their contracts and documents. Payroll (and
// its bridge into the finance ledger) lives in the next section.
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE // ativo
  ON_LEAVE // afastado (férias/licença)
  TERMINATED // desligado
}

enum ContractType {
  CLT
  PJ
  INTERN // estágio
  TEMPORARY // temporário
  FREELANCER // autônomo
}

/// A department (org catalog), e.g. "Comercial", "Operações".
model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

/// A job role / cargo (org catalog), e.g. "Vendedor", "Engenheiro".
model JobRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("job_roles")
}

/// An employee of the organization. Deliberately SEPARATE from User/Membership:
/// an employee may have no system login (`userId` null), and a user (e.g. an
/// external admin) need not be an employee. When linked, the id lets HR reach
/// the person's CRM work (opportunities owned, tasks assigned).
model Employee {
  id             String  @id @default(cuid())
  organizationId String
  /// Optional link to the system user. Null = doesn't use the app (no seat).
  userId         String?

  // ── Personal
  name          String
  email         String?
  phone         String?
  documentType  DocumentType?
  /// Digits only (normalized); CPF for individuals, CNPJ for PJ.
  document      String?
  birthDate     DateTime?
  avatarUrl     String?
  addressZip    String?
  addressStreet String?
  addressNumber String?
  addressCity   String?
  addressState  String?

  // ── Contract
  jobRoleId         String?
  departmentId      String?
  contractType      ContractType   @default(CLT)
  status            EmployeeStatus @default(ACTIVE)
  /// Admissão.
  hiredAt           DateTime
  /// Fim do período de experiência (drives an alert).
  probationEndsAt   DateTime?
  terminatedAt      DateTime?
  terminationReason String?
  /// Monthly base salary — the seed of every payroll line.
  baseSalary        Decimal        @default(0) @db.Decimal(12, 2)
  weeklyHours       Int?

  // ── Payment details
  bankName    String?
  bankBranch  String?
  bankAccount String?
  pixKey      String?

  notes       String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRole      JobRole?    @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  documents    EmployeeDocument[]
  payrollItems PayrollItem[]
  timeOff      TimeOff[]

  /// At most one employee per system user, per org.
  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@map("employees")
}

/// A file on an employee's record (contract, ID, medical certificate…). Bytes
/// live in object storage; only metadata + URL here, mirroring the other
/// attachment models. `expiresAt` powers the "document expiring" alert.
model EmployeeDocument {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  name           String
  mime           String
  size           Int
  url            String
  expiresAt      DateTime?
  uploadedById   String?
  createdAt      DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

// ---------------------------------------------------------------------------
// Payroll (folha de pagamento) — the bridge from HR into the finance ledger.
// Paying a run posts one EXPENSE FinanceEntry per employee, so salaries show up
// in Fluxo de Caixa and DRE without any re-typing.
// ---------------------------------------------------------------------------

/// DRAFT = editável; APPROVED = fechada, pronta para pagar; PAID = lançada no
/// Financeiro (imutável).
enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

/// EARNING = provento (soma); DEDUCTION = desconto (subtrai).
enum PayrollLineType {
  EARNING
  DEDUCTION
}

/// One month's payroll (competência ano/mês). Unique per org+month.
model PayrollRun {
  id             String        @id @default(cuid())
  organizationId String
  year           Int
  month          Int // 1-12
  status         PayrollStatus @default(DRAFT)
  /// Payment date — becomes the generated entries' dueDate/settledAt.
  payDate        DateTime
  /// Finance category for the generated expenses (drives the DRE breakdown).
  categoryId     String?
  notes          String?

  totalEarnings   Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @db.Decimal(14, 2)
  totalNet        Decimal @default(0) @db.Decimal(14, 2)

  approvedAt  DateTime?
  paidAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items PayrollItem[]

  @@unique([organizationId, year, month])
  @@index([organizationId, status])
  @@map("payroll_runs")
}

/// One employee's payslip inside a run. Carries name/role snapshots so the
/// payslip stays stable even if the employee record changes or is deleted.
model PayrollItem {
  id             String  @id @default(cuid())
  organizationId String
  payrollRunId   String
  employeeId     String?
  employeeName   String
  jobRoleName    String?

  baseSalary      Decimal @default(0) @db.Decimal(12, 2)
  totalEarnings   Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  netPay          Decimal @default(0) @db.Decimal(12, 2)

  /// The FinanceEntry generated for this person when the run was paid.
  financeEntryId String?
  createdAt      DateTime @default(now())

  run      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  lines    PayrollLine[]

  @@unique([payrollRunId, employeeId])
  @@index([organizationId, employeeId])
  @@map("payroll_items")
}

/// A line on a payslip: "Salário base", "Comissão", "INSS", "Vale-transporte"…
model PayrollLine {
  id             String          @id @default(cuid())
  organizationId String
  payrollItemId  String
  type           PayrollLineType
  label          String
  amount         Decimal         @db.Decimal(12, 2)
  order          Int             @default(0)

  item PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, payrollItemId])
  @@map("payroll_lines")
}

// ---------------------------------------------------------------------------
// Time off (férias, licenças, faltas) — request → approval, with notifications.
// ---------------------------------------------------------------------------

enum TimeOffType {
  VACATION // férias
  SICK // atestado / licença médica
  LEAVE // licença (maternidade, etc.)
  ABSENCE // falta
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A time-off request for an employee. Approved entries feed the "who's away"
/// view; pending ones raise an alert for the managers.
model TimeOff {
  id             String        @id @default(cuid())
  organizationId String
  employeeId     String
  type           TimeOffType   @default(VACATION)
  status         TimeOffStatus @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  /// Inclusive calendar-day span, computed on write.
  days           Int           @default(0)
  reason         String?
  /// Note left by whoever approved/rejected it.
  decisionNote   String?
  requestedById  String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@index([organizationId, startDate])
  @@map("time_off")
}

// ---------------------------------------------------------------------------
// Supplies module (Suprimentos) — Fase 1: base cadastros
// ---------------------------------------------------------------------------

/// A supplier / vendor for the supplies & procurement module.
model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Optional trade / fantasy name.
  tradeName      String?
  /// CNPJ/CPF (digits only, normalized).
  document       String?
  email          String?
  phone          String?
  /// Main contact person at the supplier.
  contactName    String?
  city           String?
  uf             String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, name])
  @@map("suppliers")
}

/// The item's nature/category — drives which fields and rules apply.
enum SupplyItemType {
  MATERIAL // material de consumo
  INSUMO // insumo (lote/validade)
  PATRIMONIO // ativo próprio (ficha individual)
  CLIENT_EQUIPMENT // equipamento de cliente (custódia)
  SERVICE // serviço (calibração, frete, locação)
  KIT // conjunto
}

/// Who owns the item — defines posse, responsabilidade e movimentação.
enum PropertyNature {
  OWN // próprio da empresa
  CLIENT // de cliente
  THIRD_PARTY // alugado de terceiro
  RESALE // mercadoria para revenda
}

/// Single item registry (cadastro único). Conditional fields/rules are driven by
/// `type` + `nature`; operational screens (stock, assets, calibration) read this.
model SupplyItem {
  id             String @id @default(cuid())
  organizationId String

  // Bloco 1 — Identificação
  code             String?
  description      String
  shortName        String?
  unit             String?
  category         String?
  brand            String?
  model            String?
  barcode          String?
  ncm              String?
  manufacturerCode String?

  // Bloco 2 — Classificação
  type                SupplyItemType @default(MATERIAL)
  nature              PropertyNature @default(OWN)
  controlsStock       Boolean        @default(true)
  controlsLot         Boolean        @default(false)
  controlsValidity    Boolean        @default(false)
  individualControl   Boolean        @default(false)
  canSell             Boolean        @default(false)
  canRent             Boolean        @default(false)
  canReserve          Boolean        @default(true)
  requiresCalibration Boolean        @default(false)
  requiresMaintenance Boolean        @default(false)
  critical            Boolean        @default(false)

  // Bloco 3 — Suprimento e custo
  supplierId   String?
  leadTimeDays Int?
  minStock     Decimal? @db.Decimal(14, 3)
  maxStock     Decimal? @db.Decimal(14, 3)
  reorderPoint Decimal? @db.Decimal(14, 3)
  lastCost     Decimal? @db.Decimal(14, 2)
  avgCost      Decimal? @db.Decimal(14, 2)
  salePrice    Decimal? @db.Decimal(14, 2)
  rentPrice    Decimal? @db.Decimal(14, 2)
  costCenter   String?

  // Bloco 4 — Armazenamento
  defaultWarehouse String?
  location         String?
  shelf            String?
  weight           Decimal? @db.Decimal(12, 3)
  dimensions       String?
  hazardous        Boolean  @default(false)
  logisticsNotes   String?

  // Bloco 5 — Dados técnicos e conformidade (o essencial; detalhe na calibração)
  calibrationPeriodMonths Int?
  maintenancePeriodMonths Int?
  warningDays             Int?
  measurementRange        String?
  resolution              String?

  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, type])
  @@index([organizationId, description])
  @@map("supply_items")
}

/// Item category (support registry).
model SupplyCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, name])
  @@map("supply_categories")
}

/// Unit of measure (support registry).
model SupplyUnit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Short symbol, e.g. "un", "kg", "m".
  abbreviation   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, name])
  @@map("supply_units")
}

/// Warehouse / stock location (support registry).
model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  location       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, name])
  @@map("warehouses")
}

/// A stock movement. IN/TRANSFER_IN raise the balance, OUT/TRANSFER_OUT lower it,
/// ADJUST is signed. Immutable ledger (source of truth): the balance of an item
/// in a warehouse is Σ qty. Corrections use a reversal movement (reversalOfId),
/// never a delete.
enum StockMovementType {
  IN
  OUT
  ADJUST
  TRANSFER_IN
  TRANSFER_OUT
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  itemId         String
  /// Affected location (null = unspecified location bucket).
  warehouseId    String?
  type           StockMovementType
  /// Signed effect on the balance (positive raises, negative lowers).
  qty            Decimal           @db.Decimal(14, 3)
  lot            String?
  validity       DateTime?
  unitCost       Decimal?          @db.Decimal(14, 2)
  /// Origin/motive (OC, doação, ajuste de inventário, transferência…).
  reason         String?
  /// Free reference: obra/OS/documento.
  reference      String?
  note           String?
  /// Ties the two rows of a transfer together.
  transferGroupId String?
  /// When set, this movement reverses another (estorno).
  reversalOfId   String?
  createdById    String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, itemId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

/// A soft hold on stock: it does not change the physical balance, only lowers
/// what is available (available = physical − Σ active reservations). Consuming a
/// reservation turns it into a physical OUT movement.
enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model StockReservation {
  id             String                 @id @default(cuid())
  organizationId String
  itemId         String
  warehouseId    String?
  qty            Decimal                @db.Decimal(14, 3)
  status         StockReservationStatus @default(ACTIVE)
  reason         String?
  /// Free reference: obra/OS/cliente.
  reference      String?
  note           String?
  createdById    String?
  releasedAt     DateTime?
  consumedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId, itemId])
  @@index([organizationId, status])
  @@map("stock_reservations")
}

/// Lifecycle of an individual asset (patrimônio).
enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

/// An individual, trackable asset (patrimônio próprio, equipamento de cliente,
/// item alugado de terceiro). Optionally an instance of a catalog SupplyItem.
model Asset {
  id               String         @id @default(cuid())
  organizationId   String
  /// Patrimônio / tombamento code.
  code             String?
  name             String
  /// Optional link to the catalog item that models this asset.
  itemId           String?
  serialNumber     String?
  nature           PropertyNature @default(OWN)
  status           AssetStatus    @default(AVAILABLE)
  supplierId       String?
  warehouseId      String?
  /// Free-text current physical location.
  location         String?
  /// Free-text person responsible for the asset.
  custodian        String?
  /// Owner CRM Company when this is client/third-party equipment.
  ownerCompanyId   String?
  acquisitionDate  DateTime?
  acquisitionValue Decimal?       @db.Decimal(14, 2)
  notes            String?
  active           Boolean        @default(true)
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  maintenanceEvents MaintenanceEvent[]

  @@index([organizationId, status])
  @@index([organizationId, code])
  @@map("assets")
}

enum MaintenanceType {
  MAINTENANCE
  CALIBRATION
}

enum MaintenanceStatus {
  SCHEDULED
  DONE
  CANCELED
}

/// A maintenance or calibration event for an individual asset. Completing one
/// can auto-schedule the next from the linked item's periodicity.
model MaintenanceEvent {
  id             String            @id @default(cuid())
  organizationId String
  assetId        String
  type           MaintenanceType
  status         MaintenanceStatus @default(SCHEDULED)
  dueDate        DateTime
  performedAt    DateTime?
  /// Who performed it (internal team or external lab/supplier).
  provider       String?
  cost           Decimal?          @db.Decimal(14, 2)
  /// Calibration certificate number.
  certificate    String?
  /// Free-text result (e.g. aprovado/reprovado + observações).
  result         String?
  /// Next scheduled date computed on completion (for reference).
  nextDueDate    DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, assetId])
  @@index([organizationId, status, dueDate])
  @@map("maintenance_events")
}

/// Custody/service lifecycle for a client's equipment brought in for service.
enum ServiceTicketStatus {
  RECEIVED
  IN_SERVICE
  READY
  RETURNED
  CANCELED
}

model ServiceTicket {
  id             String              @id @default(cuid())
  organizationId String
  /// Sequential per-org-per-year code, e.g. "0001/26".
  code           String?
  /// Optional link to a registered client-equipment Asset.
  assetId        String?
  /// Client (CRM Company).
  companyId      String?
  /// Snapshot description of the equipment.
  equipment      String
  status         ServiceTicketStatus @default(RECEIVED)
  /// Reported problem / service to perform.
  description    String?
  receivedAt     DateTime
  expectedReturn DateTime?
  returnedAt     DateTime?
  responsible    String?
  cost           Decimal?            @db.Decimal(14, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, companyId])
  @@map("service_tickets")
}

/// Purchase order lifecycle. DRAFT is a request/quote; receiving posts each line
/// to the stock ledger (StockMovement IN). PARTIAL when some lines are pending.
enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIAL
  RECEIVED
  CANCELED
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  /// Sequential per-org-per-year code, e.g. "0001/26".
  code           String?
  supplierId     String?
  status         PurchaseOrderStatus @default(DRAFT)
  /// Default destination for received goods.
  warehouseId    String?
  expectedAt     DateTime?
  notes          String?
  /// Σ(line total), stored so listings don't recompute.
  total          Decimal             @default(0) @db.Decimal(14, 2)
  approvedAt     DateTime?
  approvedById   String?
  orderedAt      DateTime?
  receivedAt     DateTime?
  /// Set once the order is posted to the finance ledger (prevents double-posting).
  financeEntryId String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  organizationId  String
  purchaseOrderId String
  /// Optional link to the catalog item (null = free line).
  itemId          String?
  /// Snapshot description (kept even if the item is renamed/removed).
  description     String
  quantity        Decimal @default(0) @db.Decimal(14, 3)
  unitPrice       Decimal @default(0) @db.Decimal(14, 2)
  /// quantity × unitPrice, stored so totals don't recompute on read.
  total           Decimal @default(0) @db.Decimal(14, 2)
  /// How much has already been received into stock.
  receivedQty     Decimal @default(0) @db.Decimal(14, 3)
  order           Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId, purchaseOrderId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// AI Copilot (assistant)
// ---------------------------------------------------------------------------

/// A conversation between a user and the in-app AI copilot. One ongoing thread
/// per user by default; keeps history so context survives across sessions and
/// so tool calls are auditable. Org-scoped like every tenant model.
model AssistantThread {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages AssistantMessage[]

  @@index([organizationId, userId, updatedAt])
  @@map("assistant_threads")
}

/// One turn in an assistant thread. `role` is "user" | "assistant". `content`
/// stores the rendered text; tool activity is summarized into it (the raw
/// tool_use/tool_result blocks are not persisted).
model AssistantMessage {
  id             String   @id @default(cuid())
  organizationId String
  threadId       String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("assistant_messages")
}
